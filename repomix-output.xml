<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blindenstock KI-Modul</title>
    
    <script src="https://cdn.jsdelivr.net/npm/onnxruntime-web/dist/ort.min.js"></script>
    
    <style>
        body { font-family: Arial, sans-serif; text-align: center; background: #121212; color: white; margin: 0; padding: 20px; }
        h1 { color: #00adb5; font-size: 20px; }
        #status { color: #ffde7d; font-weight: bold; margin-top: 10px; font-size: 14px; }
        
        /* Container begrenzt sich auf die maximale Breite des Streams */
        #stream-container { position: relative; display: inline-block; margin-top: 20px; border: 2px solid #333; max-width: 100%; }
        
        /* Bild passt sich dem Handydisplay an */
        img { display: block; max-width: 100%; height: auto; }
        
        /* Canvas zwingen, sich JEDER Skalierung des Bildes exakt anzupassen */
        canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
    </style>
</head>
<body>

    <h1>Intelligenter Blindenstock - KI Web-Interface</h1>
    <div id="status">Lade KI-Modell...</div>

    <div id="stream-container">
        <img id="videoStream" src="http://10.97.102.18/stream" crossorigin="anonymous" width="640" height="480">
        <canvas id="overlay" width="640" height="480"></canvas>
    </div>

    <script>
        const img = document.getElementById('videoStream');
        const canvas = document.getElementById('overlay');
        const ctx = canvas.getContext('2d');
        const statusDiv = document.getElementById('status');
        let session;

        // Die offiziellen 80 COCO-Objektklassen, die YOLOv8 kennt
        const labels = ["person", "bicycle", "car", "motorcycle", "airplane", "bus", "train", "truck", "boat", "traffic light", "fire hydrant", "stop sign", "parking meter", "bench", "bird", "cat", "dog", "horse", "sheep", "cow", "elephant", "bear", "zebra", "giraffe", "backpack", "umbrella", "handbag", "tie", "suitcase", "frisbee", "skis", "snowboard", "sports ball", "kite", "baseball bat", "baseball glove", "skateboard", "surfboard", "tennis racket", "bottle", "wine glass", "cup", "fork", "knife", "spoon", "bowl", "banana", "apple", "sandwich", "orange", "broccoli", "carrot", "hot dog", "pizza", "donut", "cake", "chair", "couch", "potted plant", "bed", "dining table", "toilet", "tv", "laptop", "mouse", "remote", "keyboard", "cell phone", "microwave", "oven", "toaster", "sink", "refrigerator", "book", "clock", "vase", "scissors", "teddy bear", "hair drier", "toothbrush"];

        async function initKI() {
            try {
                // Nutzung des WebAssembly-Backends für maximale Kompatibilität ohne HTTPS
                session = await ort.InferenceSession.create('./yolov8n.onnx', { executionProviders: ['wasm'] });
                statusDiv.innerHTML = "KI-Modell einsatzbereit! Analysiere Stream...";
                statusDiv.style.color = "#00adb5";
                processFrame();
            } catch (e) {
                statusDiv.innerHTML = "Fehler beim Laden des Modells: " + e;
                statusDiv.style.color = "red";
            }
        }

        async function processFrame() {
            if (!session) return;

            // Temporärer Canvas für das YOLOv8-Format (640x640 Pixel)
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = 640;
            tempCanvas.height = 640;
            const tempCtx = tempCanvas.getContext('2d');
            tempCtx.drawImage(img, 0, 0, 640, 640);

            const imgData = tempCtx.getImageData(0, 0, 640, 640);
            const inputTensor = prepareInput(imgData);

            const feeds = { [session.inputNames[0]]: inputTensor };
            const outputs = await session.run(feeds);
            const output = outputs[session.outputNames[0]];

            // Übergabe der Rohdaten an den neuen Auswerter
            drawBoundingBoxes(output.data);

            // Nächsten Frame anfordern
            requestAnimationFrame(processFrame);
        }

        function prepareInput(imgData) {
            const [r, g, b] = [[], [], []];
            for (let i = 0; i < imgData.data.length; i += 4) {
                r.push(imgData.data[i] / 255.0);
                g.push(imgData.data[i + 1] / 255.0);
                b.push(imgData.data[i + 2] / 255.0);
            }
            const float32Data = new Float32Array([...r, ...g, ...b]);
            return new ort.Tensor('float32', float32Data, [1, 3, 640, 640]);
        }

        // ========================================================
        // NEU: YOLOV8 DECODER & FILTER (POST-PROCESSING)
        // ========================================================
        function drawBoundingBoxes(outputData) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            let boxes = [];
            // YOLOv8n liefert 8400 mögliche Box-Kandidaten im Array
            for (let c = 0; c < 8400; c++) {
                let maxScore = 0;
                let classId = -1;
                
                // Zeilen 4 bis 83 enthalten die Wahrscheinlichkeiten für die 80 Klassen
                for (let r = 4; r < 84; r++) {
                    let score = outputData[r * 8400 + c];
                    if (score > maxScore) {
                        maxScore = score;
                        classId = r - 4;
                    }
                }
                
                // Nur Objekte mit mehr als 45% Wahrscheinlichkeit heraussuchen
                if (maxScore > 0.45) {
                    let cx = outputData[0 * 8400 + c];
                    let cy = outputData[1 * 8400 + c];
                    let w = outputData[2 * 8400 + c];
                    let h = outputData[3 * 8400 + c];
                    
                    // Korrektur der 1:1 Stauchung zurück auf das echte 4:3 Format (640x480)
                    // Da das Bild im KI-Modell vertikal von 480 auf 640 gestreckt wurde:
                    let x = cx - w / 2;
                    let y = (cy - h / 2) * (480 / 640); 
                    let width = w;
                    let height = h * (480 / 640);
                    
                    // Begrenzung, damit Boxen nicht über den Canvas-Rand ragen
                    x = Math.max(0, Math.min(640, x));
                    y = Math.max(0, Math.min(480, y));
                    
                    boxes.push({x, y, width, height, score: maxScore, classId});
                }
            }
            
            // Schnelle Unterdrückung von doppelten/überlappenden Rahmen (Basis-NMS)
            boxes.sort((a, b) => b.score - a.score);
            let filteredBoxes = [];
            for (let box of boxes) {
                let overlap = false;
                for (let fBox of filteredBoxes) {
                    if (Math.abs(box.x - fBox.x) < 40 && Math.abs(box.y - fBox.y) < 40) {
                        overlap = true;
                        break;
                    }
                }
                if (!overlap) filteredBoxes.push(box);
                if (filteredBoxes.length >= 6) break; // Maximal 6 Objekte gleichzeitig anzeigen
            }

            // Rahmen und Text auf das Canvas zeichnen
            for (let box of filteredBoxes) {
                // Rahmen zeichnen
                ctx.strokeStyle = "#00adb5";
                ctx.lineWidth = 3;
                ctx.strokeRect(box.x, box.y, box.width, box.height);
                
                // Hintergrund-Label für den Text zeichnen
                ctx.fillStyle = "#00adb5";
                ctx.font = "bold 14px Arial";
                let text = `${labels[box.classId]} ${(box.score * 100).toFixed(0)}%`;
                ctx.fillText(text, box.x + 5, box.y + 18);
            }
        }

        img.onload = () => { initKI(); };
    </script>
</body>
</html>
